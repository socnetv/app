      <string>Mode:</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QRadioButton" name="allRadioButton">
     <property name="text">
      <string>All (undirected networks only)</string>
     </property>
     <property name="toolTip">
      <string>Ties are treated as undirected. Only valid on an undirected network.</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QRadioButton" name="outRadioButton">
     <property name="text">
      <string>Out (directed networks only) - based on ties this actor sends</string>
     </property>
     <property name="toolTip">
      <string>Only valid on a directed network.</string>
     </property>
    </widget>
   </item>
   <item>
