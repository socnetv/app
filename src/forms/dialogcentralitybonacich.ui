       </property>
       <property name="value">
        <double>0.100000000000000</double>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="hintLabel">
     <property name="text">
      <string>Beta must be smaller in absolute value than 1 / (the network's largest eigenvalue). If it's too large, the report will show all-zero scores and explain why in the status bar. With negative beta, scores can come out negative - that is expected, not an error.</string>
     </property>
